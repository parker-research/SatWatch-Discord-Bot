# Copy this to .env and fill in your values

# Required: Discord bot token (from https://discord.com/developers/applications)
DISCORD_TOKEN=your_bot_token_here

# Optional: For fast slash command registration during development.
# Set to your Discord server (guild) ID to register commands instantly.
# Leave unset to register globally (can take up to 1 hour to propagate).
# DISCORD_GUILD_ID=your_guild_id_here

# Logging level (error, warn, info, debug, trace)
RUST_LOG=satwatch_discord_bot=info
